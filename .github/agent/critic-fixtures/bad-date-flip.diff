diff --git a/src/rules.ts b/src/rules.ts
--- a/src/rules.ts
+++ b/src/rules.ts
@@ -40,6 +40,14 @@ export function findDrift(items: PlanItem[], issues: WorkIssue[], options: Options): Finding[] {
     }
+    for (const issue of linked) {
+      if (item.dueDate && issue.dueDate && issue.dueDate < item.dueDate) {
+        findings.push({
+          rule: "DATE_CONFLICT", severity: "medium",
+          summary: `${issue.key} is due after ${item.name}`, evidence: { item: item.id, issue: issue.key },
+        });
+      }
+    }
   }
   return findings;
 }
